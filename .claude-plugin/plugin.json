{
  "name": "ritoko",
  "version": "0.1.0",
  "description": "Turn a browser task your agent solved once into a reliable, resumable procedure: rerun it with new data, verified, without double submission.",
  "author": {
    "name": "Swih",
    "url": "https://github.com/Swih"
  },
  "homepage": "https://ritoko.com",
  "repository": "https://github.com/Swih/ritoko",
  "license": "MIT",
  "keywords": [
    "browser",
    "automation",
    "rpa",
    "workflow",
    "playwright",
    "replay"
  ],
  "mcpServers": {
    "ritoko": {
      "command": "npx",
      "args": [
        "-y",
        "ritoko@0.1.0",
        "mcp"
      ]
    }
  }
}
