{
  "name": "ritoko",
  "version": "0.2.0",
  "description": "Resumable browser, HTTP API and MCP automation for AI agents. Verify CSV/Excel batches with a local journal.",
  "license": "MIT",
  "mcpName": "io.github.Swih/ritoko",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ritoko": "bin/ritoko.mjs"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "vitest run --configLoader native",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --configLoader native",
    "test:package": "vitest run test/package.e2e.test.ts --config vitest.e2e.config.ts --configLoader native",
    "release:check": "node scripts/release-check.mjs",
    "mcp": "node src/cli.ts mcp",
    "ritoko": "node src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "playwright-core": "1.63.0",
    "read-excel-file": "9.3.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chai": "5.2.3",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swih/ritoko.git"
  },
  "homepage": "https://ritoko.com",
  "keywords": [
    "browser",
    "automation",
    "rpa",
    "workflow",
    "playwright",
    "mcp",
    "claude-code",
    "codex",
    "ai-agents",
    "csv",
    "excel",
    "batch-processing",
    "resumable-workflows"
  ]
}
